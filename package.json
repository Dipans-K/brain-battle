{
  "name": "brain-battle",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time multiplayer quiz game for Netlify and Render",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build.js",
    "test:unit": "node --test tests/unit.test.js",
    "test:mock": "node --test tests/unit.test.js tests/mock-multiplayer.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1"
  }
}
